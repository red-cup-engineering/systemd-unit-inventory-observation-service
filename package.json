{
  "name": "@red-cup-engineering/systemd-unit-inventory-observation-service",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Read-only systemd unit inventory observation across every host in the Union swarm, for asset bookkeeping.",
  "keywords": [
    "systemd",
    "asset-inventory",
    "observation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/systemd-unit-inventory-observation-service.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "observe-unit-inventory": "scripts/observe-unit-inventory.mjs"
  },
  "scripts": {
    "observe-unit-inventory": "node scripts/observe-unit-inventory.mjs",
    "check": "node --check src/observe-unit-inventory.mjs && node --check scripts/observe-unit-inventory.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  }
}
